# Copied to .env by `just bootstrap` when .env is missing.
# Host-side Django uses these published ports. The compose `web`
# service overrides POSTGRES_HOST=db and REDIS_URL=redis://redis:6379/0.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
REDIS_URL=redis://127.0.0.1:6379/0
